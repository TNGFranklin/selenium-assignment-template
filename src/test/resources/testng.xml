<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="XYZ Bank Test Suite" verbose="1">

    <listeners>
        <listener class-name="listeners.ScreenshotListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <test name="Manager Tests">
        <classes>
            <class name="tests.ManagerTest"/>
        </classes>
    </test>

    <test name="Customer Tests">
        <classes>
            <class name="tests.CustomerTest"/>
        </classes>
    </test>

    <test name="Navigation Tests">
        <classes>
            <class name="tests.NavigationTest"/>
        </classes>
    </test>

</suite>
